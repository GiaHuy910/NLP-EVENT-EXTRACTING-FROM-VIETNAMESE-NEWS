FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app/server

COPY server/requirements-docker.txt ./requirements-docker.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu \
       -r requirements-docker.txt

COPY server/src ./src
COPY server/models/config.json ./models/config.json
COPY server/models/model.safetensors ./models/model.safetensors
COPY server/models/tokenizer_config.json ./models/tokenizer_config.json
COPY server/models/vocab.txt ./models/vocab.txt
COPY server/models/bpe.codes ./models/bpe.codes
COPY server/models/added_tokens.json ./models/added_tokens.json

EXPOSE 8000

CMD ["uvicorn", "src.ner_pipeline.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
